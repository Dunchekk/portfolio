generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
/// LISTED appears in the archive without a detail link; DRAFT is entirely private.
enum PublicationStatus {
  DRAFT
  LISTED
  PUBLISHED
}
enum BlockKind {
  TEXT
  IMAGE
}
/// Editorial aggregate. Version prevents lost updates from simultaneous tabs.
model Project {
  id          String @id @default(cuid())
  slug        String @unique @db.VarChar(120)
  title       String @db.VarChar(200)
  summary     String @default("") @db.VarChar(500)
  date        DateTime @db.Date
  status      PublicationStatus @default(DRAFT)
  version     Int @default(1)
  coverId     String?
  cover       Media? @relation("ProjectCover", fields: [coverId], references: [id], onDelete: Restrict)
  categories  Category[]
  blocks      ProjectBlock[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([status, date, id])
}
/// Reusable classification for archive filters.
model Category {
  id       String @id @default(cuid())
  name     String @unique @db.VarChar(80)
  projects Project[]
}
/// Ordered within an explicit desktop column (0..2). Payload is checked in SQL.
model ProjectBlock {
  id        String @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column    Int
  position  Int
  kind      BlockKind
  text      String? @db.Text
  mediaId   String?
  media     Media? @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  alt       String @default("") @db.VarChar(500)
  caption   String @default("") @db.VarChar(1000)
  @@unique([projectId, column, position])
  @@index([mediaId])
}
/// Immutable normalized image. Files live outside the public directory.
model Media {
  id        String @id @default(cuid())
  key       String @unique
  width     Int
  height    Int
  bytes     Int
  mime      String
  createdAt DateTime @default(now())
  blocks    ProjectBlock[]
  covers    Project[] @relation("ProjectCover")
}
